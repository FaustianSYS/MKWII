<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flightsim_qt_gui</name>
  <version>0.1.0</version>
  <description>C++ Qt5 tactical GUI with OpenGL 3D track visualization</description>
  <maintainer email="dev@flightsim.local">FlightSim</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>flightsim_msgs</depend>
  <depend>std_msgs</depend>
  <depend>ament_index_cpp</depend>

  <build_depend>qtbase5-dev</build_depend>
  <build_depend>libqt5opengl5-dev</build_depend>
  <exec_depend>libqt5opengl5</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
