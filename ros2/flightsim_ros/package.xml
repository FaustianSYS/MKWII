<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flightsim_ros</name>
  <version>0.1.0</version>
  <description>FlightSim ROS 2 FDM node (non-safety partition)</description>
  <maintainer email="dev@flightsim.local">FlightSim</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>flightsim_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>qtbase5-dev</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-websockets</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
